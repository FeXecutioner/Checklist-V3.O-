rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerifiedOwner(uid) {
      return isAuthenticated()
        && request.auth.uid == uid
        && request.auth.token.email == 'mihirramdhani@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Only allow verified owner access to their own /privateSync documents
    match /privateSync/{uid}/{document=**} {
      allow read, write: if isVerifiedOwner(uid);
    }

    // Explicitly deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
